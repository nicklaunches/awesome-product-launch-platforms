{
  "name": "meetqy-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "check": "biome check .",
    "check:unsafe": "biome check --write --unsafe .",
    "check:write": "biome check --write .",
    "clean:links": "node scripts/clean-links.mjs",
    "dedupe:links": "node scripts/dedupe-links-data.mjs && pnpm run gen:readme-links",
    "prune:dead-links": "node scripts/prune-dead-links.mjs && pnpm run gen:readme-links",
    "deploy": "pnpm run build:cf && wrangler deploy",
    "dev": "next dev --turbo",
    "gen:readme-links": "node scripts/generate-readme-links.mjs",
    "preview": "next build && next start",
    "preview:cf": "opennextjs-cloudflare preview",
    "start": "next start",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "upgrade:next": "npx @next/codemod@canary upgrade latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.2",
    "next": "16.3.6",
    "nuqs": "^2.8.9",
    "react": "19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.5",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@cloudflare/workers-types": "^4.20260429.1",
    "@opennextjs/cloudflare": "^1.19.4",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "wrangler": "^4.86.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@10.21.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
